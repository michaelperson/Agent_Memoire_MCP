# Jour 4 : ligne à AJOUTER à la fin de votre fichier .env (remplacez l'IP par la vôtre, voir ipconfig).
# Puis : docker compose up -d   (recrée le conteneur n8n avec ce réglage)

# URL publique de vos webhooks : n8n l'affiche dans les nœuds et l'utilise dans les liens d'approbation.
# Sans elle, le webhook répond quand même sur l'IP, mais n8n affiche et envoie des liens en http://localhost:5678.
WEBHOOK_URL=http://192.168.1.42:5678/

# NE PAS ajouter N8N_SECURE_COOKIE=false.
# Par défaut, l'éditeur ouvert depuis http://<IP>:5678 affiche une erreur « secure cookie » :
# c'est une protection utile, personne d'autre que vous n'a à ouvrir votre éditeur.
