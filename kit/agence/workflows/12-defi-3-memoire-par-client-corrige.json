        "postgres": {
          "id": "",
          "name": "PostgreSQL agence"
        }
      }
    },
    {
      "id": "n113",
      "name": "chercher_dossier",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        460,
        240
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Retrouve le dossier d'un client à partir de son adresse e-mail. Entrée : email (texte). Sortie : destination, date de départ, nombre de personnes et statut, ou une liste vide.",
        "operation": "executeQuery",
        "query": "SELECT destination, date_depart, nb_personnes, statut\nFROM dossiers\nWHERE client_email = $1;",
        "options": {
          "queryReplacement": "={{ $fromAI('email', \"Adresse e-mail du client\", 'string') }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "PostgreSQL agence"
        }
      }
    },
    {
      "id": "n114",
      "name": "Répondre",
