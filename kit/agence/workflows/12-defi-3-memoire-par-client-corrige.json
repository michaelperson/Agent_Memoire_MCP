      "typeVersion": 3.1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=De : {{ $json.body.expediteur }}\n\n{{ $json.body.texte }}",
        "options": {
          "systemMessage": "Tu es l'assistant de l'agence de voyages. Tu réponds aux messages des clients.\nTu disposes de la mémoire des échanges précédents avec ce client : appuie-toi dessus.\nPour une question sur une réservation, cherche le dossier avec chercher_dossier.\nRéponds en deux phrases maximum.",
          "maxIterations": 5,
          "returnIntermediateSteps": true
        }
      }
    },
    {
      "id": "n111",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        140,
        240
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5",
          "cachedResultName": "Claude Sonnet 5"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "Anthropic (clé du parcours)"
        }
      }
    },
    {
      "id": "n112",
      "name": "Postgres Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.4,
      "position": [
        300,
        240
      ],
      "parameters": {
